# Service settings; copy to .env and fill in.

# Ollama local model for the advisor chat
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2


# Live avatar conversation
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_VOICE_ID=
LIVEAVATAR_SANDBOX=true

# Optional point-in-time S&P 500 membership source
SP500_HISTORY_URL=
